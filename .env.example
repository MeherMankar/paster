# Storage. Required in production; without it `pnpm dev` uses an in-memory store.
# The Vercel Marketplace names (KV_REST_API_URL / KV_REST_API_TOKEN) also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin used for absolute links, OG images and the CLI installer.
# Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=

# Optional policy
# MAX_PASTE_BYTES=1048576      # content cap in bytes (default 1 MiB)
# MAX_EXPIRY=30d               # longest allowed expiry (10m, 1h, 1d, 7d, 30d); unset allows "never"

# Optional operator features
# ADMIN_TOKEN=                 # bearer token for /api/v1/admin/* and deleting any paste
# REPORT_WEBHOOK_URL=          # abuse reports are POSTed here as Discord-compatible JSON (includes the paste link)
# TELEGRAM_BOT_TOKEN=          # abuse reports go to Telegram with Open + Remove buttons (default: off)
# TELEGRAM_CHAT_ID=            # chat/user/group id that receives them; needs NEXT_PUBLIC_SITE_URL for auto-setup
# REPORT_SALT=                 # salt for hashed reporter IPs; defaults to ADMIN_TOKEN, then the Redis token

# Self-hosting behind a reverse proxy: number of trusted proxies adding X-Forwarded-For.
# Vercel needs nothing. Default 1.
# TRUSTED_PROXY_HOPS=1

# Local testing only. Never set these in production.
# ALLOW_MEMORY_STORE=1         # run `next start` without Redis
# DISABLE_RATE_LIMIT=1
